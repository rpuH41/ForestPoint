<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Add the PUBLIC token pk.… (NOT a secret sk.… token). -->
    <key>PublicAccessToken</key>
    <string>pk.YOUR_PUBLIC_MAPBOX_TOKEN</string>
</dict>
</plist>
